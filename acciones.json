{
  "version": 1,
  "acciones": [
    {
      "nombre": "anyadir-lectura",
      "descripcion": "Copia una lectura de otra carpeta a la carpeta ~/lecturas",
      "tipo": "copiar",
      "filtro": { "extensiones": [".pdf", ".docx", ".odt", ".txt"] },
      "destino": "~/lecturas"
    },
    {
      "nombre": "mover-a-integracionsocial",
      "descripcion": "Mueve documentos de la carpeta pendientes a la carpeta Integración Social",
      "tipo": "mover",
      "filtro": { "extensiones": [".pdf", ".docx", ".odt", ".txt"] },
      "origen": "~/lecturas/pendientes",
      "destino": "~/lecturas/Integración Social"
    },
    {
      "nombre": "borrar",
      "descripcion": "Permite eliminar archivos seleccionados por la usuaria al ejecutar el comando",
      "tipo": "borrar",
      "confirmar": true
    },
    {
      "nombre": "renombrar",
      "descripcion": "Permite cambiar el nombre de archivos seleccionados por la usuaria al ejecutar el comando",
      "tipo": "renombrar",
      "plantilla": "{nombre}{ext}"
    },
    {
      "nombre": "mover-a-educacioninfantil",
      "descripcion": "Mueve documentos a la carpeta Educación Infantil",
      "tipo": "mover",
      "filtro": { "extensiones": [".pdf", ".docx", ".odt", ".txt"] },
      "origen": "~/lecturas/pendientes",
      "destino": "~/lecturas/Educación Infantil"
    },
    {
      "nombre": "resumir",
      "descripcion": "Resume documentos con la IA del centro y guarda el resultado en un .resumen.md",
      "tipo": "resumir",
      "filtro": { "extensiones": [".txt", ".md", ".pdf"] }
    },
    {
      "nombre": "nombrar-escaneos",
      "descripcion": "Propone con la IA un nombre claro para cada escaneo PDF y lo renombra en su carpeta",
      "tipo": "renombrar-ia",
      "filtro": { "extensiones": [".pdf"], "patron": "(?i)^(escaneo|scan|documento|descarga)" }
    },
    {
      "nombre": "clasificar-lecturas",
      "descripcion": "Clasifica con la IA cada lectura y la mueve físicamente a su carpeta de categoría",
      "tipo": "clasificar",
      "filtro": { "extensiones": [".pdf", ".txt", ".md", ".docx", ".odt"] },
      "categorias": {
        "educacioninfantil": "~/lecturas/Educación Infantil",
        "integracionsocial": "~/lecturas/Integración Social",
        "otros": "~/lecturas/otros"
      }
    }
  ]
}